# Groq API (free tier: https://console.groq.com)
GROQ_API_KEY=

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Instagrapi fallback (optional)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Facebook Page API (uses same app as Instagram)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# TikTok Content Publishing API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# Threads API (https://developers.facebook.com/docs/threads)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# X / Twitter API (https://developer.x.com)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn API (https://developer.linkedin.com)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AUTHOR_URN=

# Music — Jamendo free API (https://developer.jamendo.com)
JAMENDO_CLIENT_ID=

# Gemini (browser automation uses your logged-in session)
GEMINI_COOKIES_PATH=data/browser_sessions/gemini

# Media serving (for Graph API - needs public URL)
MEDIA_BASE_URL=http://localhost:8000

# App settings
DATABASE_URL=sqlite:///data/mittified.db
LOG_LEVEL=INFO
TIMEZONE=Asia/Karachi
